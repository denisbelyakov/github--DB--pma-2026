package com.example.ukol3dicethrowxml

import android.os.Bundle
import android.widget.Button
import android.widget.TextView
import androidx.activity.enableEdgeToEdge
import androidx.appcompat.app.AppCompatActivity
import androidx.core.view.ViewCompat
import androidx.core.view.WindowInsetsCompat
import androidx.lifecycle.lifecycleScope
import kotlinx.coroutines.delay
import kotlinx.coroutines.launch

// Hlavní aktivita aplikace pro házení kostkou
class MainActivity : AppCompatActivity() {
    
    // Metoda volaná při vytvoření aktivity
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        enableEdgeToEdge()
        setContentView(R.layout.activity_main)
        
        // Nastavení okrajů pro zobrazení přes celou obrazovku (Edge-to-Edge)
        ViewCompat.setOnApplyWindowInsetsListener(findViewById(R.id.llmain)) { v, insets ->
            val systemBars = insets.getInsets(WindowInsetsCompat.Type.systemBars())
            v.setPadding(systemBars.left, systemBars.top, systemBars.right, systemBars.bottom)
            insets
        }

        // Inicializace tlačítek a textových prvků z layoutu
        val btnRoll = findViewById<Button>(R.id.btnRoll)
        val ivDice = findViewById<TextView>(R.id.ivDice)

        // Seznam Unicode znaků pro jednotlivé strany kostky (1 až 6)
        val diceFaces = listOf("⚀", "⚁", "⚂", "⚃", "⚄", "⚅")

        // Obsluha kliknutí na tlačítko pro hod kostkou
        btnRoll.setOnClickListener {
            // Spuštění asynchronní korutiny pro plynulou animaci hodu
            lifecycleScope.launch {
                btnRoll.isEnabled = false

                var currentDelay = 40L
                val steps = 14
                
                // Plynulá animace s efektem zpomalení (Ease-out)
                repeat(steps) { step ->
                    ivDice.text = diceFaces.random()
                    currentDelay += (step * 8)
                    delay(currentDelay)
                }

                // Výpočet náhodného čísla a zobrazení finálního výsledku
                val diceValue = (1..6).random()
                ivDice.text = diceFaces[diceValue - 1]

                btnRoll.isEnabled = true
            }
        }
    }
}

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llmain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F5F3FF"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titulek"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hod' Kostkou"
        android:textSize="28dp"
        android:textStyle="bold"
        android:textColor="#352060"
        />
    <TextView
        android:id="@+id/ivDice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24sp"
        android:layout_marginBottom="24sp"
        android:text="⚀"
        android:textSize="120sp"
        android:textColor="#352060" />

    <Button
        android:id="@+id/btnRoll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hodit"
        android:textSize="24sp" />

</LinearLayout>
